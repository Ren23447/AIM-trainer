function animate(){requestAnimationFrame(animate);let dt=Math.min(clock.getDelta(),.1),now=performance.now(),t=now*.00035;if(mixer)mixer.update(dt);if(sun){sun.position.set(Math.cos(t)*24,24+Math.sin(t*.7)*8,Math.sin(t)*18);sun.lookAt(0,3,-15);fillLight.position.set(Math.sin(t*1.7)*12,4+Math.sin(t)*2,-8+Math.cos(t)*8)}if(state==="playing"){let left=Math.max(0,60000-(now-startTime));$("time").textContent=(left/1000).toFixed(1);if(left<=0){state="results";controls.unlock();document.querySelector(".cross").style.display="none";$("results").classList.remove("hidden");$("resultScore").textContent=String(score).padStart(6,"0");$("resultHits").textContent=hits;$("resultAccuracy").textContent=(shots?Math.round(hits/shots*100):100)+"%";$("resultStreak").textContent=best}}for(let i=bullets.length-1;i>=0;i--){let b=bullets[i],step=b.velocity.clone().multiplyScalar(dt),distance=step.length(),from=b.mesh.position.clone(),to=from.clone().add(step),hit=null;b.trail.geometry.setFromPoints([from.clone(),from.clone().addScaledVector(b.velocity.clone().normalize(),-.8)]);if(!b.noHit)for(let g of targets){if(g.userData.hit)continue;let bounds=new THREE.Box3().setFromObject(g.children[0]).expandByScalar(.12),segment=new THREE.Ray(from,b.velocity.clone().normalize());segment.far=distance;if(segment.intersectBox(bounds,new THREE.Vector3())){hit=g;break}}if(hit){registerHit(hit);scene.remove(b.mesh,b.trail);bullets.splice(i,1)}else{b.mesh.position.copy(to);b.trail.geometry.attributes.position.needsUpdate=true;b.life-=dt;if(b.life<=0){scene.remove(b.mesh,b.trail);bullets.splice(i,1)}}}renderer.render(scene,camera)}
function settings(show,from="home"){settingsReturn=from;$("settings").classList.toggle("hidden",!show);$("home").classList.toggle("hidden",show||from!=="home");$("pause").classList.toggle("hidden",show||from!=="pause")}
function applyVideo(){let q=$("quality").value,ratio=q==="low"?1:q==="high"?Math.min(devicePixelRatio||1,2):Math.min(devicePixelRatio||1,1.5);renderer.setPixelRatio(ratio);renderer.shadowMap.enabled=$("shadows").checked;camera.fov=+$("fov").value;camera.updateProjectionMatrix();document.querySelector(".cross").style.display=$("crosshair").value==="on"&&state==="playing"?"block":"none"}
const audio=$("radioAudio");audio.volume=.35;$("station").onchange=()=>{$("customStation").classList.toggle("hidden",$("station").value!=="custom")};$("radioPlay").onclick=()=>{let url=$("station").value==="custom"?$("customStation").value:$("station").value;if(!url){$("radioStatus").textContent="Enter a stream URL first.";return}audio.src=url;audio.volume=+$("radioVolume").value;audio.play().then(()=>$("radioStatus").textContent="Radio playing.").catch(()=>$("radioStatus").textContent="This station blocked playback; try another stream.")};$("radioStop").onclick=()=>{audio.pause();$("radioStatus").textContent="Radio is stopped."};$("radioVolume").oninput=e=>audio.volume=+e.target.value;
$("fullscreenBtn").onclick=async()=>{let d=document,e=d.documentElement;if(!d.fullscreenElement&&!d.webkitFullscreenElement){let fn=e.requestFullscreen||e.webkitRequestFullscreen||e.msRequestFullscreen;if(fn)try{await fn.call(e)}catch(err){console.warn("Fullscreen request was denied",err)}else{e.classList.add("pseudoFullscreen");$("fullscreenBtn").textContent="EXIT FULLSCREEN"}}else{let fn=d.exitFullscreen||d.webkitExitFullscreen||d.msExitFullscreen;if(fn)await fn.call(d);else{e.classList.remove("pseudoFullscreen");$("fullscreenBtn").textContent="FULLSCREEN"}}};addEventListener("fullscreenchange",()=>$("fullscreenBtn").textContent=document.fullscreenElement?"EXIT FULLSCREEN":"FULLSCREEN");addEventListener("webkitfullscreenchange",()=>$("fullscreenBtn").textContent=document.webkitFullscreenElement?"EXIT FULLSCREEN":"FULLSCREEN");$("play").onclick=begin;$("resume").onclick=pause;$("resultAgain").onclick=begin;$("resultHome").onclick=()=>{state="home";$("results").classList.add("hidden");$("home").classList.remove("hidden")};$("pauseHome").onclick=()=>{state="home";$("pause").classList.add("hidden");$("home").classList.remove("hidden");document.querySelector(".cross").style.display="none";controls.unlock()};$("settingsBtn").onclick=()=>settings(true,"home");$("pauseSettings").onclick=()=>settings(true,"pause");$("settingsBack").onclick=()=>{applyVideo();settings(false,settingsReturn)};$("sens").oninput=e=>{sensitivity=+e.target.value;controls.pointerSpeed=sensitivity;$("sensOut").value=sensitivity.toFixed(1)};$("fov").oninput=e=>{$("fovOut").value=e.target.value+"°";applyVideo()};$("crosshair").onchange=applyVideo;$("quality").onchange=applyVideo;$("shadows").onchange=applyVideo;$("volume").oninput=e=>volume=+e.target.value;addEventListener("mousedown",e=>{if(e.button===0)shoot()});addEventListener("keydown",e=>{if(e.code==="Escape"&&(state==="playing"||state==="paused"))pause();if(e.code==="KeyR")reload()});setup();
